CREATE DATABASE imobiliaria;
USE imobiliaria;

-- =====================================
-- TIPOS DE USUÁRIO
-- =====================================

CREATE TABLE UserType (
    idUserType INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(45) NOT NULL
);

-- =====================================
-- USUÁRIOS
-- =====================================

CREATE TABLE Users (
    idUser INT AUTO_INCREMENT PRIMARY KEY,
    idUserType INT NOT NULL,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,

    FOREIGN KEY (idUserType)
        REFERENCES UserType(idUserType)
);

-- =====================================
-- INQUILINOS
-- =====================================

CREATE TABLE Inquilinos (
    idInquilino INT AUTO_INCREMENT PRIMARY KEY,
    idUser INT NOT NULL UNIQUE,
    mensagemInquilino VARCHAR(200),

    FOREIGN KEY (idUser)
        REFERENCES Users(idUser)
);

-- =====================================
-- PROPRIETÁRIOS
-- =====================================

CREATE TABLE Proprietarios (
    idProprietario INT AUTO_INCREMENT PRIMARY KEY,
    idUser INT NOT NULL UNIQUE,
    receita DECIMAL(10,2) DEFAULT 0,
    mensagemProprietario VARCHAR(200),

    FOREIGN KEY (idUser)
        REFERENCES Users(idUser)
);

-- =====================================
-- IMÓVEIS
-- =====================================

CREATE TABLE Imoveis (
    idImovel INT AUTO_INCREMENT PRIMARY KEY,
    idProprietario INT NOT NULL,

    localizacao VARCHAR(150) NOT NULL,
    quantidadeQuartos INT NOT NULL,
    disponibilidade BOOLEAN DEFAULT TRUE,
    atraso BOOLEAN DEFAULT FALSE,

    FOREIGN KEY (idProprietario)
        REFERENCES Proprietarios(idProprietario)
);

-- =====================================
-- CONTRATOS
-- =====================================

CREATE TABLE Contratos (
    idContrato INT AUTO_INCREMENT PRIMARY KEY,

    idImovel INT NOT NULL,
    idInquilino INT NOT NULL,

    valorAluguel DECIMAL(10,2) NOT NULL,
    dataInicio DATE NOT NULL,
    dataFim DATE,
    status ENUM(
        'ATIVO',
        'ENCERRADO',
        'PENDENTE'
    ) DEFAULT 'ATIVO',

    FOREIGN KEY (idImovel)
        REFERENCES Imoveis(idImovel),

    FOREIGN KEY (idInquilino)
        REFERENCES Inquilinos(idInquilino)
);

-- =====================================
-- PAGAMENTOS
-- =====================================

CREATE TABLE Pagamentos (
    idPagamento INT AUTO_INCREMENT PRIMARY KEY,

    idContrato INT NOT NULL,

    pix VARCHAR(500),
    qrCode VARCHAR(500),
    comprovante VARCHAR(120),

    valor DECIMAL(10,2) NOT NULL,
    dataPagamento DATE,
    status ENUM(
        'PENDENTE',
        'PAGO',
        'ATRASADO'
    ) DEFAULT 'PENDENTE',

    FOREIGN KEY (idContrato)
        REFERENCES Contratos(idContrato)
);

-- =====================================
-- ATENDIMENTOS
-- =====================================

CREATE TABLE Atendimentos (
    idAtendimento INT AUTO_INCREMENT PRIMARY KEY,

    idImovel INT NOT NULL,

    data DATE NOT NULL,
    observacao VARCHAR(200),
    realizado BOOLEAN DEFAULT FALSE,

    FOREIGN KEY (idImovel)
        REFERENCES Imoveis(idImovel)
);

-- =====================================
-- FAQ CATEGORIAS
-- =====================================

CREATE TABLE Faq_Categorias (
    idCategoria INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(45) NOT NULL,
    ativo BOOLEAN DEFAULT TRUE
);

-- =====================================
-- FAQS
-- =====================================

CREATE TABLE Faqs (
    idFaq INT AUTO_INCREMENT PRIMARY KEY,

    idCategoria INT,

    pergunta VARCHAR(255) NOT NULL,
    resposta VARCHAR(255) NOT NULL,
    ativo BOOLEAN DEFAULT TRUE,

    FOREIGN KEY (idCategoria)
        REFERENCES Faq_Categorias(idCategoria)
);

-- =====================================
-- CHAT
-- =====================================

CREATE TABLE Chat (
    idChat INT AUTO_INCREMENT PRIMARY KEY,
    idContrato INT,
    dataCriacao DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (idContrato)
        REFERENCES Contratos(idContrato)
);

-- =====================================
-- MENSAGENS
-- =====================================

CREATE TABLE Mensagens (
    idMensagem INT AUTO_INCREMENT PRIMARY KEY,

    idChat INT NOT NULL,
    idRemetente INT NOT NULL,

    mensagem TEXT NOT NULL,
    dataHora DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (idChat)
        REFERENCES Chat(idChat),

    FOREIGN KEY (idRemetente)
        REFERENCES Users(idUser)
);