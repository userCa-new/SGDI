DROP DATABASE IF EXISTS imobiliaria;

CREATE DATABASE imobiliaria;
USE imobiliaria;

CREATE TABLE user_type (
    id_user_type INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(45) NOT NULL
);

CREATE TABLE users (
    id_user INT AUTO_INCREMENT PRIMARY KEY,
    id_user_type INT NOT NULL,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,

    FOREIGN KEY (id_user_type)
        REFERENCES user_type(id_user_type)
        ON DELETE CASCADE
);

CREATE TABLE properties (
    id_property INT AUTO_INCREMENT PRIMARY KEY,
    location VARCHAR(150) NOT NULL,
    number_of_rooms INT NOT NULL,
    availability BOOLEAN DEFAULT TRUE,
    late_payment BOOLEAN DEFAULT FALSE
);

CREATE TABLE contracts (
    id_contract INT AUTO_INCREMENT PRIMARY KEY,
    id_property INT NOT NULL,
    id_user INT NOT NULL,

    rent_value DECIMAL(10,2) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE,

    status ENUM(
        'ACTIVE',
        'CLOSED',
        'PENDING'
    ) DEFAULT 'ACTIVE',

    FOREIGN KEY (id_property)
        REFERENCES properties(id_property)
        ON DELETE CASCADE,

    FOREIGN KEY (id_user)
        REFERENCES users(id_user)
        ON DELETE CASCADE
);

CREATE TABLE payments (
    id_payment INT AUTO_INCREMENT PRIMARY KEY,

    id_contract INT NOT NULL,

    pix VARCHAR(500),
    qr_code VARCHAR(500),
    receipt VARCHAR(120),

    value DECIMAL(10,2) NOT NULL,
    payment_date DATE,

    status ENUM(
        'PENDING',
        'PAID',
        'LATE'
    ) DEFAULT 'PENDING',

    FOREIGN KEY (id_contract)
        REFERENCES contracts(id_contract)
        ON DELETE CASCADE
);

CREATE TABLE appointments (
    id_appointment INT AUTO_INCREMENT PRIMARY KEY,

    id_property INT NOT NULL,

    date DATE NOT NULL,
    observation VARCHAR(200),

    completed BOOLEAN DEFAULT FALSE,

    FOREIGN KEY (id_property)
        REFERENCES properties(id_property)
        ON DELETE CASCADE
);

CREATE TABLE faq_categories (
    id_category INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(45) NOT NULL,
    active BOOLEAN DEFAULT TRUE
);

CREATE TABLE faqs (
    id_faq INT AUTO_INCREMENT PRIMARY KEY,

    id_category INT,

    question VARCHAR(255) NOT NULL,
    answer VARCHAR(255) NOT NULL,

    active BOOLEAN DEFAULT TRUE,

    FOREIGN KEY (id_category)
        REFERENCES faq_categories(id_category)
        ON DELETE SET NULL
);

CREATE TABLE chat (
    id_chat INT AUTO_INCREMENT PRIMARY KEY,

    id_contract INT,

    creation_date DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (id_contract)
        REFERENCES contracts(id_contract)
        ON DELETE CASCADE
);

CREATE TABLE messages (
    id_message INT AUTO_INCREMENT PRIMARY KEY,

    id_chat INT NOT NULL,
    id_sender INT NOT NULL,

    message TEXT NOT NULL,
    date_time DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (id_chat)
        REFERENCES chat(id_chat)
        ON DELETE CASCADE,

    FOREIGN KEY (id_sender)
        REFERENCES users(id_user)
        ON DELETE CASCADE
);

